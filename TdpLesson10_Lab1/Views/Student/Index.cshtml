@model IEnumerable<TdpLesson10_Lab1.Models.Student>
@using TdpLesson10_Lab1.Models

@{
   

    ViewData["Title"] = "Danh sách sinh viên";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}

<h2>Danh sách sinh viên</h2>

<a asp-controller="Student"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Create Student
</a>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ đào tạo</th>
            <th>Địa chỉ</th>
            <th>Email</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>
                    @(s.DateOfBorth == default
                        ? ""
                        : s.DateOfBorth.ToString("dd/MM/yyyy"))
                </td>
                <td>
                    @(s.Branch switch
                    {
                        Branch.IT => "CNTT",
                        Branch.BE => "Kinh tế",
                        Branch.CE => "Công trình",
                        Branch.EE => "Điện - Điện tử",
                        _ => ""
                    })
                </td>
                <td>
                    @(s.Gender == Gender.Male ? "Nam" : "Nữ")
                </td>
                <td>
                    @(s.IsRegular ? "Chính quy" : "Phi chính quy")
                </td>
                <td>@s.Address</td>
                <td>@s.Email</td>
            </tr>
        }
    </tbody>
</table>
